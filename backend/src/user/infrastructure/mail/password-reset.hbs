<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Reset your password</title>
</head>
<body style="margin:0; padding:0; background-color:#f4f6f8; font-family: Arial, sans-serif;">

<table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f6f8; padding:20px;">
    <tr>
        <td align="center">

            <table width="500" cellpadding="0" cellspacing="0" style="background:#ffffff; border-radius:12px; overflow:hidden;">

                <!-- Header -->
                <tr>
                    <td style="background:#4f46e5; padding:20px; text-align:center; color:#ffffff;">
                        <h1 style="margin:0;">Reset your password 🔒</h1>
                    </td>
                </tr>

                <!-- Body -->
                <tr>
                    <td style="padding:30px; color:#333333;">

                        <h2 style="margin-top:0;">Hi 👋</h2>

                        <p>
                            We received a request to reset the password for your
                            <strong>Book Shop</strong> account.
                            Click the button below to choose a new one.
                        </p>

                        <!-- Button -->
                        <div style="text-align:center; margin:30px 0;">
                            <a href="{{link}}"
                               style="background:#4f46e5; color:#ffffff; padding:12px 25px;
                                      text-decoration:none; border-radius:6px; display:inline-block;">
                                Reset Password
                            </a>
                        </div>

                        <p style="font-size:14px; color:#777;">
                            Or copy and paste this link into your browser:
                        </p>
                        <p style="word-break:break-all; font-size:13px;">
                            <a href="{{link}}" style="color:#4f46e5;">{{link}}</a>
                        </p>

                        <p style="font-size:14px; color:#777;">
                            This link will expire in 1 hour. If you didn’t request a
                            password reset, you can safely ignore this email — your
                            password will stay the same.
                        </p>

                        {{#if reportLink}}
                        <div style="margin:24px 0; padding:16px; background:#fff7ed; border:1px solid #fed7aa; border-radius:6px;">
                            <p style="margin:0 0 12px; font-size:14px; color:#333333;">
                                If you didn’t request this password reset or someone changed
                                your password without your permission, please let us know.
                            </p>
                            <a href="{{reportLink}}" style="font-size:14px; color:#4f46e5; text-decoration:underline;">
                                Report an unauthorized password change
                            </a>
                        </div>
                        {{/if}}

                        <p style="margin-bottom:0;">
                            Best regards,<br>
                            <strong>The Team</strong>
                        </p>

                    </td>
                </tr>

                <!-- Footer -->
                <tr>
                    <td style="background:#f1f1f1; text-align:center; padding:15px; font-size:12px; color:#777;">
                        © 2026 Your Company. All rights reserved.
                    </td>
                </tr>

            </table>

        </td>
    </tr>
</table>

</body>
</html>